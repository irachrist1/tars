# === TARS data-safety .gitignore — deny by intent, not just by name ===

# Secrets and credentials (never commit, ever)
*.env
.env*
*token*
*secret*
*.pem
*.key
*.p12
*.pfx
*.keychain
credentials*
config.local.*
**/auth/*.json

# OS credential / cloud dirs that may get symlinked or copied in by mistake
.aws/
.ssh/
.config/

# Real user data captured during a run — output, never source
/runs/
/out/
*.local
*.local.*
sample-data-with-real-content*
**/real-vault/**

# Any path that looks like a LIVE Obsidian / second-brain vault.
# Note: templates/vault/** is intentional and tracked — it ships blank synthetic
# templates, NOT a live vault. The pre-commit scan guards it against real data.
**/Obsidian Vault/**
**/iCloud~md~obsidian/**
/runs/**/Notes/**
/runs/**/00_System/**

# Node
node_modules/
npm-debug.log*
.DS_Store

# Build artifacts — the upload bundle is generated by `npm run package`
/dist/

# TARS local index — derived data, rebuilt on demand, never committed
.tars-index/
